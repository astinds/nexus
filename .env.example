# NEXUS v1.0 environment template. Copy to backend/.env (or export in the shell) and fill in.
# Never commit a filled-in copy: .env is gitignored.

# ---------------------------------------------------------------- backend/ ---
# PostgreSQL / Supabase connection string.
# Supabase: Project Settings -> Database -> Connection string -> "URI".
# Use the pooler host (port 6543) for Render Free: it survives connection resets.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Single-user passcode gate. Leave EMPTY for open local development
# (/api/v1/health then reports dev_open_access=true). Set a long random value
# in production; clients send it as the X-Nexus-Key header or unlock once at
# /api/v1/auth/session to receive an HttpOnly session cookie.
NEXUS_ACCESS_KEY=

# Storage backend: "local" (files under LOCAL_STORAGE_DIR) or "supabase".
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.nexus-storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=nexus-files

# Uploads larger than this are rejected with a clear error (Render Free = 512 MB RAM).
MAX_UPLOAD_MB=25

# Comma-separated browser origins allowed to call the API directly.
# The Next.js rewrite proxy makes this unnecessary in the normal deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true only when the API is served over HTTPS (production).
COOKIE_SECURE=false
LOG_LEVEL=INFO

# --------------------------------------------------------------- frontend/ ---
# Server-side proxy target used by next.config.js rewrites().
API_BACKEND_URL=http://127.0.0.1:8000
# Optional: set only when the browser must call FastAPI directly (bypasses the
# zero-CORS proxy). Leave empty in the recommended setup.
NEXT_PUBLIC_API_ORIGIN=
